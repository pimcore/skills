#!/usr/bin/env bash
#
# phpnav — fast PHP code navigation via a symbol index (ctags) + ripgrep.
#
# Why this exists: `find` searches filenames and `grep -r` scans raw text, so
# "where is class X defined?" turns into a full scan that returns every mention.
# A symbol index maps each class/function/method/etc. to its exact definition,
# so a lookup is a single sorted-file read instead of a scan of the whole tree.
#
# Commands:
#   phpnav index            (re)build the symbol index for the current project
#   phpnav def   <symbol>   show where a class/function/method/etc. is DEFINED
#   phpnav refs  <symbol>   show every place a symbol is USED (ripgrep, PHP only)
#   phpnav outline <file>   list the symbols defined in one file, in order
#   phpnav grep  <pattern>  free-text search restricted to PHP files
#
# The index lives in $PHPNAV_TAGS (default: .php-tags in the project root).
# Add that filename to .gitignore — it is a build artifact.

set -euo pipefail

TAGS_FILE="${PHPNAV_TAGS:-.php-tags}"
# Symbol kinds worth indexing: classes, constants, functions, interfaces,
# namespaces, traits, variables/properties. Local variables (l) and aliases (a)
# are intentionally excluded — they create huge noise with no navigation value.
KINDS="cdfintv"

die() { printf 'phpnav: %s\n' "$*" >&2; exit 1; }

need() {
  command -v "$1" >/dev/null 2>&1 || die "$1 not found. $2"
}

cmd_index() {
  need ctags "Install universal-ctags (apt install universal-ctags / brew install universal-ctags)."
  # -n  => store line NUMBERS as the address (trivial to parse: file<TAB>line)
  # -R  => recurse; ctags honours .gitignore-style excludes for vendor/ etc. is
  #        not automatic, so we exclude the usual heavy dirs explicitly.
  ctags -R -n \
    --languages=PHP \
    --kinds-PHP="$KINDS" \
    --exclude=vendor --exclude=node_modules --exclude=.git \
    --exclude='*.min.php' \
    -f "$TAGS_FILE" . 2>/dev/null || die "ctags failed to build the index."
  local n
  n=$(grep -cv '^!' "$TAGS_FILE" 2>/dev/null || echo 0)
  printf 'Indexed %s PHP symbols -> %s\n' "$n" "$TAGS_FILE"
}

ensure_index() {
  [ -f "$TAGS_FILE" ] || { printf 'No index found, building one...\n' >&2; cmd_index >&2; }
}

# Print a tag hit as:  path:line  [kind]  name
# readtags emits:  name <TAB> file <TAB> line;"  <TAB> kind:<k> ...
# (No dependency on `column`; many systems don't ship it.)
print_hits() {
  awk -F'\t' '
    {
      name=$1; file=$2;
      line=$3; sub(/;".*/, "", line);          # strip the ;"... trailer
      kind="?";
      for (i=4; i<=NF; i++) {
        if ($i ~ /^kind:/)      { kind=$i; sub(/^kind:/, "", kind) }
        else if (length($i)==1) { kind=$i }     # short-form kind field
      }
      printf "%s:%s  [%s]  %s\n", file, line, kind, name
    }' | sort -u
}

cmd_def() {
  [ $# -ge 1 ] || die "usage: phpnav def <symbol>"
  ensure_index
  local sym="$1" out
  if command -v readtags >/dev/null 2>&1; then
    # -e exact match. readtags needs a sorted tags file (ctags sorts by default).
    out=$(readtags -t "$TAGS_FILE" -e "$sym" 2>/dev/null || true)
  else
    out=$(awk -F'\t' -v s="$sym" '$1==s' "$TAGS_FILE" 2>/dev/null || true)
  fi
  [ -n "$out" ] || die "no definition found for '$sym'. Try: phpnav refs '$sym'"
  printf '%s\n' "$out" | print_hits
}

cmd_refs() {
  [ $# -ge 1 ] || die "usage: phpnav refs <symbol>"
  need rg "Install ripgrep (apt install ripgrep / brew install ripgrep)."
  # -w word boundary so "User" doesn't match "UserFactory"; PHP files only.
  # The trailing "." is required: without an explicit path, ripgrep reads stdin.
  # vendor/ and node_modules/ are excluded to match `index` (override by
  # cd-ing into vendor/ if you specifically need library internals).
  rg --type php -n -w --color=never -g '!vendor' -g '!node_modules' -- "$1" . \
    || die "no usages of '$1' found in PHP files."
}

cmd_outline() {
  [ $# -ge 1 ] || die "usage: phpnav outline <file>"
  need ctags "Install universal-ctags."
  [ -f "$1" ] || die "file not found: $1"
  # -x prints a human-readable cross-reference (symbol, kind, line, source line).
  ctags -x --languages=PHP --kinds-PHP="$KINDS" "$1" \
    || die "could not outline '$1'."
}

cmd_grep() {
  [ $# -ge 1 ] || die "usage: phpnav grep <pattern>"
  need rg "Install ripgrep."
  rg --type php -n --color=never -g '!vendor' -g '!node_modules' -- "$1" . \
    || die "no matches for '$1' in PHP files."
}

usage() {
  sed -n '/^# phpnav —/,/it is a build artifact/p' "$0" | sed 's/^# \{0,1\}//'
}

main() {
  [ $# -ge 1 ] || { usage; exit 1; }
  local sub="$1"; shift
  case "$sub" in
    index)        cmd_index "$@" ;;
    def|d)        cmd_def "$@" ;;
    refs|r|uses)  cmd_refs "$@" ;;
    outline|o)    cmd_outline "$@" ;;
    grep|g|search) cmd_grep "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command '$sub'. Run 'phpnav help'." ;;
  esac
}

main "$@"
